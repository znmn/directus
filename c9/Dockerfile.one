FROM linuxserver/cloud9:latest

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    screen \
    python3 \
    nodejs \
    php-cli \
    sudo \
    nano \
    dos2unix \
    cron && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create scripts directory
RUN mkdir -p /etc/services.d/cron /usr/local/bin

# Create ping_host.sh with UNIX line endings; note the variable is now PING_HOST
RUN printf '#!/bin/sh\n\
[ -n "$PING_HOST" ] && curl -fsS "$PING_HOST" >/dev/null\n' > /usr/local/bin/ping_host.sh && \
    chmod 755 /usr/local/bin/ping_host.sh && \
    dos2unix /usr/local/bin/ping_host.sh

# Create cron service run script (just starting cron)
RUN printf '#!/bin/sh\n\
exec cron -f -L /dev/stdout\n' > /etc/services.d/cron/run && \
    chmod 755 /etc/services.d/cron/run && \
    dos2unix /etc/services.d/cron/run

# Set a default environment variable for PING_HOST so that it's available at runtime.
# You can override this at runtime with -e PING_HOST="http://your-host-url" if needed.
ENV PING_HOST=http://example.com

# Create cont-init.d scripts for swap initialization and cron file creation
RUN mkdir -p /etc/cont-init.d && \
    printf '#!/bin/sh\n\
if [ ! -f /swapfile ]; then\n\
    dd if=/dev/zero of=/swapfile bs=1M count=2048\n\
    chmod 600 /swapfile\n\
    mkswap /swapfile\n\
fi\n\
swapon /swapfile || true\n\
grep -qxF "/swapfile none swap sw 0 0" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab\n' \
> /etc/cont-init.d/10-swap && \
    chmod 755 /etc/cont-init.d/10-swap && \
    dos2unix /etc/cont-init.d/10-swap && \
    printf '#!/bin/sh\n\
echo "PING_HOST is: $PING_HOST"\n\
if [ -n "$PING_HOST" ]; then\n\
    echo "*/15 * * * * abc /usr/local/bin/ping_host.sh" > /etc/cron.d/ping-host\n\
    chmod 0644 /etc/cron.d/ping-host\n\
    echo "Cron file /etc/cron.d/ping-host created."\n\
else\n\
    echo "No PING_HOST set, not creating cron file."\n\
fi\n' \
> /etc/cont-init.d/20-create-cron && \
    chmod 755 /etc/cont-init.d/20-create-cron && \
    dos2unix /etc/cont-init.d/20-create-cron
