FROM linuxserver/cloud9:latest

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    screen \
    python3 \
    nodejs \
    php-cli \
    sudo \
    nano \
    cron && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create ping_host.sh as root
RUN echo -e '#!/bin/sh\n\
[ -n "$HOST" ] && curl -fsS "$HOST" >/dev/null' > /usr/local/bin/ping_host.sh && \
    chmod +x /usr/local/bin/ping_host.sh

# Copy custom startup script
COPY c9/start.sh /start.sh
RUN chmod +x /start.sh

# Switch to non-root user
# USER abc

# Set entrypoint
CMD ["/start.sh"]
