FROM linuxserver/cloud9:latest

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    screen \
    python3 \
    nodejs \
    php-cli \
    sudo \
    nano \
    dos2unix \
    cron && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# File environment untuk cron
RUN mkdir -p /etc/container_environment && \
    touch /etc/container_environment/HOST

# Script ping_host.sh
RUN printf '#!/bin/sh\n\
[ -n "$HOST" ] && curl -fsS "$HOST" >/dev/null\n' > /usr/local/bin/ping_host.sh && \
    chmod 755 /usr/local/bin/ping_host.sh && \
    dos2unix /usr/local/bin/ping_host.sh

# Service cron dengan env yang benar
RUN mkdir -p /etc/services.d/cron && \
    printf '#!/bin/sh\n\
. /etc/container_environment\n\
if [ -n "$HOST" ]; then\n\
    echo "*/15 * * * * abc . /etc/container_environment && /usr/local/bin/ping_host.sh" > /etc/cron.d/ping-host\n\
    chmod 0644 /etc/cron.d/ping-host\n\
    exec cron -f\n\
else\n\
    echo "HOST not set, cron disabled"\n\
    exec sleep infinity\n\
fi\n' > /etc/services.d/cron/run && \
    chmod 755 /etc/services.d/cron/run && \
    dos2unix /etc/services.d/cron/run

# Script untuk menyimpan environment variable
RUN printf '#!/bin/sh\n\
printenv | grep -v "no_proxy" > /etc/container_environment\n\
exec /init\n' > /etc/cont-init.d/01-store-env && \
    chmod 755 /etc/cont-init.d/01-store-env
