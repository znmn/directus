FROM linuxserver/cloud9:latest

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    screen \
    python3 \
    nodejs \
    php-cli \
    sudo \
    cron && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Add swap initialization
RUN mkdir -p /etc/cont-init.d && \
    echo -e '#!/bin/bash\n\
    if [ ! -f /swapfile ]; then\n\
        fallocate -l 2G /swapfile && \
        chmod 600 /swapfile && \
        mkswap /swapfile\n\
    fi\n\
    swapon /swapfile\n\
    echo "/swapfile none swap sw 0 0" >> /etc/fstab' > /etc/cont-init.d/10-swap && \
    chmod +x /etc/cont-init.d/10-swap

# Ping host configuration
RUN echo -e '#!/bin/sh\n\
    [ -n "$HOST" ] && curl -fsS "$HOST" >/dev/null' > /usr/local/bin/ping_host.sh && \
    chmod +x /usr/local/bin/ping_host.sh && \
    mkdir -p /etc/services.d/cron && \
    echo -e '#!/bin/sh\n\
    if [ -n "$HOST" ]; then\n\
        echo "*/15 * * * * abc /usr/local/bin/ping_host.sh" > /etc/cron.d/ping-host\n\
        chmod 0644 /etc/cron.d/ping-host\n\
    fi\n\
    exec cron -f' > /etc/services.d/cron/run && \
    chmod +x /etc/services.d/cron/run

# USER abc
