FROM linuxserver/cloud9:latest

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    screen \
    python3 \
    nodejs \
    php-cli \
    sudo \
    nano \
    cron && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Configure ping host
RUN echo -e '#!/bin/sh\n\
[ -n "$HOST" ] && curl -fsS "$HOST" >/dev/null' > /usr/local/bin/ping_host.sh && \
    chmod +x /usr/local/bin/ping_host.sh

# Configure s6 cron service
RUN mkdir -p /etc/services.d/cron && \
    echo -e '#!/bin/sh\n\
if [ -n "$HOST" ]; then\n\
    echo "*/15 * * * * abc /usr/local/bin/ping_host.sh" > /etc/cron.d/ping-host\n\
    chmod 0644 /etc/cron.d/ping-host\n\
    exec cron -f\n\
else\n\
    printf "HOST not set - disabling cron\\n"\n\
    exec sleep infinity\n\
fi' > /etc/services.d/cron/run && \
    chmod +x /etc/services.d/cron/run

# Add startup script
COPY c9/start.sh /start.sh
RUN chmod +x /start.sh

# USER abc

CMD ["/start.sh"]
